# ─────────────────────────────────────────────────────────────
# PathogenIQ — Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# App
ENVIRONMENT=development
DEBUG=false

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://pathogeniq:pathogeniq_secret@localhost:5432/pathogeniq

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pathogeniq_secret

# Qdrant (vector database)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM (Phase 3) — Ollama is the default (free, local, no API key needed).
# The docker-compose sets LLM_BASE_URL automatically for the api/worker containers.
# Override here only if you want a different provider:
#   Groq free tier:  LLM_BASE_URL=https://api.groq.com/openai/v1
#                    LLM_MODEL=llama-3.3-70b-versatile
#                    LLM_API_KEY=<your groq key>
#   OpenRouter:      LLM_BASE_URL=https://openrouter.ai/api/v1
#                    LLM_MODEL=meta-llama/llama-3.2-3b-instruct:free
#                    LLM_API_KEY=<your openrouter key>
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:0.5b
LLM_API_KEY=ollama

# Biomedical APIs (Phase 2)
# Get a free PubMed API key at https://www.ncbi.nlm.nih.gov/account/
# Without key: 3 req/s. With key: 10 req/s.
PUBMED_API_KEY=

# Collector settings (Phase 2)
# How many documents to collect per source per scheduled run.
COLLECTOR_MAX_RESULTS=100

# CORS (production only — development uses "*")
# Comma-separated list of allowed frontend origins.
# Set this to your Vercel deployment URL when running on Fly.io.
# Example: CORS_ORIGINS=https://pathogeniq.vercel.app,https://pathogeniq.io
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Newsletter / SMTP
# Leave SMTP_HOST empty to disable email delivery (subscriptions still saved to DB).
# Gmail: create a 16-char App Password at myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PathogenIQ <noreply@pathogeniq.io>
FRONTEND_BASE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# PRODUCTION DEPLOYMENT (Fly.io API + Vercel frontend)
# Set these in Fly.io secrets, not in this file:
#
#   fly secrets set \
#     DATABASE_URL="postgresql+asyncpg://..." \   # Neon free tier
#     REDIS_URL="rediss://..." \                  # Upstash free tier
#     NEO4J_URI="neo4j+s://..." \                 # Neo4j Aura free tier
#     NEO4J_PASSWORD="..." \
#     QDRANT_URL="https://..." \                  # Qdrant Cloud free tier
#     QDRANT_API_KEY="..." \
#     LLM_BASE_URL="https://api.groq.com/openai/v1" \  # Groq free tier
#     LLM_MODEL="llama-3.3-70b-versatile" \
#     LLM_API_KEY="<your-groq-key>" \
#     CORS_ORIGINS="https://your-app.vercel.app" \
#     ENVIRONMENT="production"
#
# Set these in Vercel project settings → Environment Variables:
#   VITE_API_BASE_URL=https://pathogeniq-api.fly.dev
# ─────────────────────────────────────────────────────────────
