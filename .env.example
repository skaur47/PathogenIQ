# ─────────────────────────────────────────────────────────────
# PathogenIQ — Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# App
ENVIRONMENT=development
DEBUG=false

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://pathogeniq:pathogeniq_secret@localhost:5432/pathogeniq

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pathogeniq_secret

# Qdrant (vector database)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM APIs (added in Phase 3)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Biomedical APIs (added in Phase 2)
PUBMED_API_KEY=
